# LLM Provider (claude | openai | qwen | deepseek | zhipu | gemini)
LLM_PROVIDER=zhipu

# Model to use
# For zhipu: glm-4.6v, glm-4, etc.
# For gemini: gemini-2.5-flash, etc.
LLM_MODEL=glm-4.6v

# API key — Get this from your LLM provider dashboard
# For Zhipu AI: https://open.bigmodel.cn/
# For Google Gemini: https://aistudio.google.com/
LLM_API_KEY=your_api_key_here

# Database path (will be created in data/worldlens.db by default)
DATABASE_PATH=data/worldlens.db

# NewsAPI key (optional, for news.com/article sources — skip for RSS-only)
NEWSAPI_KEY=

# App settings
LOG_LEVEL=INFO
API_PORT=8000
