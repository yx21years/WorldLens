<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>WorldLens RSS 订阅源（精简版）</title>
  </head>
  <body>
    <!-- ========== 科技 ========== -->
    <outline text="科技">
      <outline type="rss" xmlUrl="https://openai.com/news/rss.xml" htmlUrl="https://openai.com/news" title="OpenAI Blog"/>
      <outline type="rss" xmlUrl="https://deepmind.google/blog/rss.xml" htmlUrl="https://deepmind.google/blog" title="Google DeepMind Blog"/>
      <outline type="rss" xmlUrl="https://research.google/blog/rss/" htmlUrl="https://research.google/blog" title="Google Research Blog"/>
      <outline type="rss" xmlUrl="https://rss.arxiv.org/rss/cs.AI" htmlUrl="https://arxiv.org/list/cs.AI/recent" title="arXiv AI"/>
      <outline type="rss" xmlUrl="https://rss.arxiv.org/rss/cs.LG" htmlUrl="https://arxiv.org/list/cs.LG/recent" title="arXiv Machine Learning"/>
      <outline type="rss" xmlUrl="https://techcrunch.com/feed/" htmlUrl="https://techcrunch.com" title="TechCrunch"/>
      <outline type="rss" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://www.theverge.com" title="The Verge"/>
      <outline type="rss" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com" title="Hacker News (Official)"/>
      <outline type="rss" xmlUrl="https://hnrss.org/frontpage" htmlUrl="https://news.ycombinator.com" title="Hacker News Frontpage"/>
      <outline type="rss" xmlUrl="https://www.smashingmagazine.com/feed/" htmlUrl="https://www.smashingmagazine.com/" title="Smashing Magazine"/>
      <outline type="rss" xmlUrl="https://blog.csdn.net/TechWeb/rss/list" htmlUrl="https://blog.csdn.net/TechWeb" title="TechWeb"/>
      <outline type="rss" xmlUrl="https://www.nature.com/nature.rss" htmlUrl="https://www.nature.com" title="Nature"/>
    </outline>

    <!-- ========== 战争/冲突 ========== -->
    <outline text="战争/冲突">
      <outline type="rss" xmlUrl="http://feeds.bbci.co.uk/news/world/rss.xml" htmlUrl="https://www.bbc.com/news" title="BBC World News"/>
      <outline type="rss" xmlUrl="http://feeds.bbci.co.uk/news/rss.xml" htmlUrl="https://www.bbc.com/news" title="BBC Top Stories"/>
      <outline type="rss" xmlUrl="http://rss.cnn.com/rss/cnn_topstories.rss" htmlUrl="https://www.cnn.com" title="CNN Top Stories"/>
      <outline type="rss" xmlUrl="http://rss.cnn.com/rss/edition_world.rss" htmlUrl="https://www.cnn.com/world" title="CNN World News"/>
      <outline type="rss" xmlUrl="https://www.aljazeera.com/xml/rss/all.xml" htmlUrl="https://www.aljazeera.com" title="Al Jazeera Top News"/>
    </outline>

    <!-- ========== 生活 ========== -->
    <outline text="生活">
      <outline type="rss" xmlUrl="https://www.ft.com/rss/home/uk" htmlUrl="https://www.ft.com" title="Financial Times Home"/>
      <outline type="rss" xmlUrl="http://www.cctv.com/program/rss/02/01/index.xml" htmlUrl="https://www.cctv.com" title="央视新闻（国内）"/>
      <outline type="rss" xmlUrl="https://feedx.net/rss/thepaper.xml" htmlUrl="https://www.thepaper.cn" title="澎湃新闻"/>
      <outline type="rss" xmlUrl="https://feedx.net/rss/nytimes.xml" htmlUrl="https://cn.nytimes.com" title="纽约时报中文网"/>
      <outline type="rss" xmlUrl="https://www.sciencedaily.com/rss/all.xml" htmlUrl="https://www.sciencedaily.com" title="ScienceDaily All News"/>
      <outline type="rss" xmlUrl="https://rss.aishort.top/?type=wasi" htmlUrl="https://rss.aishort.top/" title="WASI 知识"/>
    </outline>

    <!-- ========== 休闲（设计/艺术/音乐） ========== -->
    <outline text="休闲">
      <outline type="rss" xmlUrl="https://rss.aishort.top/?type=guokr" htmlUrl="https://www.guokr.com" title="果壳网"/>
      <outline type="rss" xmlUrl="https://rss.aishort.top/?type=sspai" htmlUrl="https://sspai.com" title="少数派"/>
      <outline type="rss" xmlUrl="https://rss.aishort.top/?type=zhihu" htmlUrl="https://www.zhihu.com" title="知乎想法热榜"/>
      <outline type="rss" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/ArtandDesign.xml" htmlUrl="https://www.nytimes.com/section/arts/design" title="NYTimes Art &amp; Design"/>
      <outline type="rss" xmlUrl="https://archdaily.com/feed" htmlUrl="https://www.archdaily.com/" title="ArchDaily"/>
      <outline type="rss" xmlUrl="https://www.dezeen.com/feed/" htmlUrl="https://www.dezeen.com/" title="Dezeen"/>
      <outline type="rss" xmlUrl="https://avantmusicnews.com/feed" htmlUrl="https://avantmusicnews.com/" title="Avant Music News"/>
      <outline type="rss" xmlUrl="https://daily.bandcamp.com/feed/" htmlUrl="https://daily.bandcamp.com/" title="Bandcamp Daily"/>
      <outline type="rss" xmlUrl="https://linesandcolors.com/feed/" htmlUrl="https://linesandcolors.com/" title="Lines and Colors"/>
      <outline type="rss" xmlUrl="https://uxdesignweekly.com/feed" htmlUrl="https://uxdesignweekly.com/" title="UX Design Weekly"/>
    </outline>
  </body>
</opml>